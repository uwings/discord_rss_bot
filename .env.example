# ===== AI 新闻 RSS Bot 配置示例 =====
# 复制本文件为 .env 并填写真实值

# Discord 频道 Webhook URL（必填）
# 获取方式：Discord 频道 → 编辑频道 → 整合 → Webhook → 新建 Webhook → 复制 URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXX/XXXXXXXX

# LLM API Key（可选）
# 配置后翻译自动改用大模型（OpenAI 兼容接口，端点见 config.toml [llm]）
# 留空则使用免费的 Google 翻译
LLM_API_KEY=
