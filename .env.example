# ===== rssbot 3.0 配置示例（复制为 .env）=====

# Discord 频道 Webhook（定时简报走这个，必填）
# 频道 → 编辑频道 → 整合 → Webhook → 新建 → 复制 URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXX/XXXXXXXX

# Discord Bot Token（启用 /ask 共脑问答时必填；不填则只跑定时简报）
# Developer Portal → New Application → Bot → Reset Token
DISCORD_BOT_TOKEN=

# 仅响应/推送此频道（Bot 模式建议填；右键频道复制 ID，需开开发者模式）
DISCORD_CHANNEL_ID=

# 填了则 slash 命令即时同步到该服务器（开发用）；不填走全局同步（最多等 1 小时）
DISCORD_GUILD_ID=

# LLM（DeepSeek 或任意 OpenAI 兼容端点见 config.toml [llm]）
# 不填会自动尝试读取本机 hermes 的 DEEPSEEK_API_KEY
LLM_API_KEY=

# KC 共脑 Bridge token
# 不填会自动从 local-data-bridge 的客户端配置解析
BRIDGE_TOKEN=
